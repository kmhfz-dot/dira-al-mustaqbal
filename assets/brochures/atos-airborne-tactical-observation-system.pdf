<?xpacket begin="ï»¿" id="W5M0MpCehiHzreSzNTczkc9d"?>
<x:xmpmeta xmlns:x="adobe:ns:meta/" x:xmptk="Adobe XMP Core 7.1-c000 79.cb7c5a1, 2022/04/14-05:22:35        ">
   <rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#">
      <rdf:Description rdf:about=""
            xmlns:dc="http://purl.org/dc/elements/1.1/"
            xmlns:pdf="http://ns.adobe.com/pdf/1.3/"
            xmlns:xmp="http://ns.adobe.com/xap/1.0/"
            xmlns:xmpMM="http://ns.adobe.com/xap/1.0/mm/"
            xmlns:stRef="http://ns.adobe.com/xap/1.0/sType/ResourceRef#"
            xmlns:stEvt="http://ns.adobe.com/xap/1.0/sType/ResourceEvent#">
         <dc:format>application/pdf</dc:format>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Adobe InDesign 17.2 (Windows)</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">brochures ILA 2022ELECTRONICS DIVISION&#xA;ATOS&#xA;AIRBORNE TACTICAL OBSERVATION &#xA;AND SURVEILLANCE SYSTEM&#xA;We apply our expertise in mission management&#xA;and our cutting-edge sensor technology to deliver&#xA;high performance, integrated solutions for ISR&#xA;missions. We work in close cooperation with&#xA;our customers to design solutions tailored on&#xA;operational needs and ensure mission success.&#xA;ATOS is an advanced Airborne Mission System that&#xA;integrates and manages various sensors and &#xA;subsystems in order to perform ISR missions.&#xA;The System adopts a Human Machine Interface&#xA;improving the User Experience and reducing&#xA;operator workload. With more than 60 operative&#xA;systems around the world, ATOS has been&#xA;enhanced over the years to meet new requirements&#xA;and needs of many international customers.&#xA;The Suite of mission sensors and other mission&#xA;equipment can be tailored to meet the specific&#xA;operational needs of each end-user and can&#xA;include Leonardo, third parties or GFE mission&#xA;sensors and equipment.&#xA;ATOS MISSION MANAGEMENT SYSTEM&#xA;MAIN FEATURES&#xA;â€¢ Real time collection and handling of mission sensors &#xA;data&#xA;â€¢ Maximum level of tactical situation awareness &#xA;through the integration of navigation, geographical &#xA;and mission sensor data&#xA;â€¢ Mission sensors control&#xA;â€¢ Automatic aiming of electro optical sensors&#xA;â€¢ Flight plan management&#xA;â€¢ Mission data recording and capability to store in a &#xA;digital format high quality video&#xA;â€¢ Mission data base management and data fusion&#xA;â€¢ Mission briefing and reporting&#xA;â€¢ Ground Control Station for mission planning/ &#xA;following/debrief, simulation and training&#xA;â€¢ Interoperability with NATO and national assets &#xA;through STANAG implementation&#xA;â€¢ Redundant configuration at hardware and software &#xA;level&#xA;â€¢ Cyber security compliant&#xA;â€¢ Customisable configuration including ITAR-FREE &#xA;solution&#xA;10&#xA;20&#xA;30&#xA;40&#xA;50&#xA;50&#xA;70&#xA;80&#xA;90&#xA;100&#xA;110&#xA;120&#xA;130&#xA;140&#xA;150&#xA;160&#xA;170180190&#xA;200&#xA;210&#xA;220&#xA;230&#xA;240&#xA;250&#xA;270&#xA;280&#xA;290&#xA;300&#xA;310&#xA;320&#xA;330&#xA;340&#xA;350 0&#xA;N&#xA;E&#xA;S&#xA;W&#xA;260&#xA;AIS  TRK 112 (SHIP)&#xA;GRC: DIONE&#xA;N 43Â°06â€™37â€&#xA;E  4Â°35â€™36â€&#xA;0 kTS / 153Â°&#xA;Time: 16:40:57&#xA;TRK 02 CONFIRMED&#xA;N 43Â°58â€™</rdf:li>
            </rdf:Alt>
         </dc:description>
         <dc:rights>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Â© Leonardo S.p.A. and subsidiaries.</rdf:li>
            </rdf:Alt>
         </dc:rights>
